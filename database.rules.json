{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email != null && root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || !root.child('settings/adminEmails').exists())"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.email != null && root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || !root.child('settings/adminEmails').exists())"
    },
    "supportTickets": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["userId", "phone", "email", "status", "timestamp"]
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    }
  }
}